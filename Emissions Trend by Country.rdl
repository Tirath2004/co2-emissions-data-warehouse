  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="EmissionsDW_Source">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=TIRTH\SQLEXPRESS;Initial Catalog=EmissionsDW;TrustServerCertificate=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>4dfc2249-359a-4009-b7a3-10dbe7bace99</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>EmissionsDW_Source</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Country">
            <Value>=Parameters!Country.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
    c.Country_Name,
    t.Year,
    f.CO2_Emissions_Total
FROM fact.Fact_Emissions f
INNER JOIN dim.DimCountry c ON f.CountryKey = c.CountryKey
INNER JOIN dim.DimTime t ON f.TimeKey = t.TimeKey
WHERE f.CO2_Emissions_Total IS NOT NULL
  AND (@Country = 'All' OR c.Country_Name = @Country)
ORDER BY c.Country_Name, t.Year</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Country_Name">
          <DataField>Country_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CO2_Emissions_Total">
          <DataField>CO2_Emissions_Total</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_CountryList">
      <Query>
        <DataSourceName>EmissionsDW_Source</DataSourceName>
        <CommandText>SELECT Country_Name FROM dim.DimCountry
UNION
SELECT 'All'
ORDER BY Country_Name</CommandText>
      </Query>
      <Fields>
        <Field Name="Country_Name">
          <DataField>Country_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
